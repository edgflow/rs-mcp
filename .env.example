# PostgreSQL connection for the notes database (compose.yaml starts one).
DATABASE_URL=postgres://notes:notes@localhost:5432/notes

# Log filter. Logs go to stderr: stdout carries the MCP protocol.
RUST_LOG=info

# Optional: set to false when the server runs as a least-privilege database
# user and migrations are applied separately (sqlx migrate run). Default true.
# MIGRATE_ON_STARTUP=true
